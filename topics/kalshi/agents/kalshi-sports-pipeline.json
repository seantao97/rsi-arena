{
  "name": "kalshi-sports-pipeline",
  "description": "Fixed pipeline. The plan decides what runs.",
  "context": "You forecast Kalshi event-contract markets on sport. You are paid for being\nright about probabilities, not for sounding confident.\n\nRules you never break:\n- Read the settlement rules before forming a view. The contract decides on its own terms,\n  not on what the market is colloquially about.\n- A price is not a probability until fees are accounted for. Kalshi's fee peaks near 50c,\n  so a 2c edge at midprice is nothing. Run price_the_edge before claiming an edge.\n- A sportsbook line is a strong prior, but only after the margin is removed. Soccer is\n  three-way: home and away alone do not partition the outcome space.\n- Where the market and your model disagree, the burden is on you. Say what the market\n  might know that you do not.\n- State what would change your mind, specifically enough to check later.\n- If nothing clears the fee, the answer is PASS. Passing is a real answer and often the\n  correct one.",
  "config": {
    "default_model": "anthropic/claude-sonnet-4.5",
    "fallback_models": [],
    "temperature": null,
    "top_p": null,
    "max_tokens": null,
    "seed": null,
    "reasoning": null,
    "provider": null,
    "timeout_s": 120.0,
    "cache": true,
    "cache_ttl_s": null,
    "web_search": false,
    "max_usd": 2.0,
    "max_calls": 200,
    "requests_per_second": 8.0,
    "concurrency": 8,
    "max_spend_mode": false,
    "bailout_reserve_usd": null,
    "bailout_model": null,
    "bailout_max_tokens": 900
  },
  "tools": [
    "active_leagues",
    "list_markets",
    "event_markets",
    "live_markets",
    "market_rules",
    "tradeable_spreads",
    "spread_ladder",
    "market_quote",
    "order_book",
    "candlesticks",
    "candlestick_probabilities",
    "previous_trades",
    "volume_profile",
    "market_at_time",
    "market_settlement",
    "orderbook_imbalance",
    "time_decay",
    "similar_situations",
    "settlement_countdown",
    "price_velocity",
    "market_shock",
    "todays_fixtures",
    "game_state",
    "recent_plays",
    "game_context",
    "sportsbook_line",
    "find_game_for_market",
    "state_change",
    "minutes_since_goal",
    "live_snapshot",
    "market_reaction",
    "unexplained_moves",
    "trading_fees",
    "price_the_edge",
    "coherence_check",
    "devig_odds",
    "kalshi_vs_book",
    "team_news",
    "web_research",
    "my_positions"
  ],
  "plan": {
    "steps": [
      {
        "type": "tool",
        "name": "rules",
        "description": "",
        "output_key": "rules",
        "skip_if": null,
        "tool": "market_rules",
        "args": {
          "ticker": "{{question}}"
        },
        "fail_ok": true
      },
      {
        "type": "tool",
        "name": "quote",
        "description": "",
        "output_key": "quote",
        "skip_if": null,
        "tool": "market_quote",
        "args": {
          "ticker": "{{question}}"
        },
        "fail_ok": true
      },
      {
        "type": "prompt",
        "name": "orient",
        "description": "",
        "output_key": "orientation",
        "skip_if": null,
        "prompt": "Contract: {{question}}\n\nSettlement terms:\n{{rules}}\n\nCurrent market:\n{{quote}}\n\nState in one line what this contract settles on, which league and fixture it refers to, and which league code to use for the game tools (MLB, NFL, NBA, EPL, LIGAMX and so on).",
        "system": null,
        "model": null,
        "temperature": null,
        "max_tokens": 220,
        "tools": [],
        "tool_choice": null,
        "max_tool_iterations": 6,
        "output_schema": null,
        "web_search": false,
        "memory": false,
        "stream": false
      },
      {
        "type": "loop",
        "name": "research",
        "description": "",
        "output_key": "evidence",
        "skip_if": null,
        "steps": [
          {
            "type": "prompt",
            "name": "gather",
            "description": "",
            "output_key": "gathered",
            "skip_if": null,
            "prompt": "Contract: {{question}}\nOrientation: {{orientation}}\nLearned so far: {{loop_results}}\n\nCall the tools that would most change your estimate. Game state and the sportsbook line usually matter most; price history and the tape tell you what the market already knows.",
            "system": null,
            "model": null,
            "temperature": null,
            "max_tokens": null,
            "tools": [
              "todays_fixtures",
              "find_game_for_market",
              "game_state",
              "recent_plays",
              "game_context",
              "sportsbook_line",
              "price_history",
              "recent_trades",
              "event_markets"
            ],
            "tool_choice": null,
            "max_tool_iterations": 4,
            "output_schema": null,
            "web_search": false,
            "memory": false,
            "stream": false
          },
          {
            "type": "prompt",
            "name": "notes",
            "description": "",
            "output_key": "notes",
            "skip_if": null,
            "prompt": "Contract: {{question}}\n\nJust gathered:\n{{gathered}}\n\nList only what the tool output actually establishes. Then say whether you could price the contract now.",
            "system": null,
            "model": null,
            "temperature": null,
            "max_tokens": null,
            "tools": [],
            "tool_choice": null,
            "max_tool_iterations": 6,
            "output_schema": {
              "type": "object",
              "properties": {
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "What the tool calls established, one per line."
                },
                "still_unknown": {
                  "type": "string"
                },
                "sufficient": {
                  "type": "boolean",
                  "description": "True only when you could price the contract now."
                }
              },
              "required": [
                "findings",
                "still_unknown",
                "sufficient"
              ],
              "additionalProperties": false
            },
            "web_search": false,
            "memory": false,
            "stream": false
          }
        ],
        "max_loops": 4,
        "until": "notes.sufficient",
        "until_prompt": null,
        "until_model": null,
        "collect": true
      },
      {
        "type": "tool",
        "name": "structure",
        "description": "",
        "output_key": "coherence",
        "skip_if": null,
        "tool": "coherence_check",
        "args": {
          "event_ticker": "{{orientation}}"
        },
        "fail_ok": true
      },
      {
        "type": "prompt",
        "name": "estimate",
        "description": "",
        "output_key": "pricing",
        "skip_if": null,
        "prompt": "Contract: {{question}}\nSettlement: {{rules}}\nMarket: {{quote}}\nEvidence: {{evidence}}\n\nGive your probability that this contract settles YES, with an interval. Then call price_the_edge with that probability and the price you would actually pay, and report what it returns.",
        "system": null,
        "model": null,
        "temperature": null,
        "max_tokens": null,
        "tools": [
          "price_the_edge",
          "devig_odds"
        ],
        "tool_choice": null,
        "max_tool_iterations": 3,
        "output_schema": null,
        "web_search": false,
        "memory": false,
        "stream": false
      },
      {
        "type": "prompt",
        "name": "write",
        "description": "",
        "output_key": "prediction",
        "skip_if": null,
        "prompt": "Contract: {{question}}\nSettlement: {{rules}}\nMarket: {{quote}}\nEvidence: {{evidence}}\nPricing: {{pricing}}\nStructural findings: {{coherence}}\n\nWrite the final call. If the edge after fees is not positive, position is PASS and stake is 0.",
        "system": null,
        "model": null,
        "temperature": null,
        "max_tokens": null,
        "tools": [],
        "tool_choice": null,
        "max_tool_iterations": 6,
        "output_schema": {
          "type": "object",
          "properties": {
            "ticker": {
              "type": "string"
            },
            "position": {
              "type": "string",
              "enum": [
                "YES",
                "NO",
                "PASS"
              ]
            },
            "probability": {
              "type": "number",
              "description": "Your probability the contract settles yes, 0-1."
            },
            "interval": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Low and high bound on that probability."
            },
            "market_price": {
              "type": "number",
              "description": "Yes ask if buying yes, yes bid if selling."
            },
            "edge_after_fees": {
              "type": "number",
              "description": "From price_the_edge, in dollars per contract."
            },
            "reasoning": {
              "type": "string",
              "description": "Why, in a few sentences. Cite what you actually looked at."
            },
            "counter_case": {
              "type": "string",
              "description": "The strongest argument against this position."
            },
            "falsifier": {
              "type": "string",
              "description": "One observation that would make this wrong."
            },
            "stake_usd": {
              "type": "number"
            },
            "settlement_note": {
              "type": "string",
              "description": "What the contract actually settles on."
            }
          },
          "required": [
            "ticker",
            "position",
            "probability",
            "interval",
            "market_price",
            "edge_after_fees",
            "reasoning",
            "counter_case",
            "falsifier",
            "stake_usd",
            "settlement_note"
          ],
          "additionalProperties": false
        },
        "web_search": false,
        "memory": false,
        "stream": false
      }
    ]
  }
}
